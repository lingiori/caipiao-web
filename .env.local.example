# Option A: server-side only (recommended for Cloudflare Pages runtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Option B: Next.js public variables (also supported as fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---- AI 问答（优先级：环境变量 > ai.config.json）----
# 默认供应商 Kimi（Kimi For Coding），DeepSeek 备选
# AI_PROVIDER=kimi
# KIMI_API_KEY=sk-...
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=k3
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# AI 问答登录会话签名密钥（部署环境必配；本地开发可留空走 ai.config.json 的 auth.sessionSecret）
# AUTH_SESSION_SECRET=随机32字节hex
