# Option A: server-side only (recommended for Cloudflare Pages runtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Option B: Next.js public variables (also supported as fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---- AI 问答（优先级：环境变量 > ai.config.json）----
# 默认供应商 Kimi（Kimi For Coding），DeepSeek 备选
# AI_PROVIDER=kimi
# KIMI_API_KEY=sk-...
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=k3
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 方案 B 中转（Kimi WAF 封锁 Cloudflare Workers 出口 IP 时启用）：
# 服务器上跑 scripts/llm_relay.py，Workers 侧改指中转并配共享密钥（key 只留服务器）
# 端口必须是 CF Workers 出站白名单之一（80/8080/8880/2052/2082/2086/2095），默认 2052
# KIMI_BASE_URL=http://<服务器IP>:2052/v1
# KIMI_RELAY_SECRET=<与服务器 RELAY_SECRET 相同>
# 配了 KIMI_RELAY_SECRET 时不再要求 KIMI_API_KEY
# AI 问答登录会话签名密钥（部署环境必配；本地开发可留空走 ai.config.json 的 auth.sessionSecret）
# AUTH_SESSION_SECRET=随机32字节hex
